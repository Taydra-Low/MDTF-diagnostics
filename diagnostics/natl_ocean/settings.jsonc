// Basic POD Settings
{
  "settings" : {
    "description" : "North Atlantic Ocean diagnostics",
    "driver" : "natl_driver.py",
    "long_name" : "North Atlantic diagnostic in Subtropical to Subpolar latitudes",
    "convention": "CMIP",
    "runtime_requirements": {
        "python3": ["matplotlib", "xarray"]
    }
  },

//  "data" : {
//    "frequency": "month",
//    "realm": "ocean"
//  },

// Variable Coordinates
  "dimensions" : {
    "nlat": {
             "standard_name": "latitude",
             "units": "degrees_north",
             "axis": "Y"
           },
    "nlon": {
             "standard_name": "longitude",
             "units": "degrees_east",
             "axis": "X"
           },
    "lev": {
             "standard_name": "depth",
             "units": "centimeters",
             "axis": "Z",
             "positive": "down"
            },
    "time": {"standard_name": "time"}//,
  },

// Variables
  "varlist" : {
    "tos": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "nlat", "nlon"],
      "standard_name" : "sea_surface_temperature",
      "units": "degC"
    },
    // Surface freshwater forcing: most CMIP models provide wfo (freshwater
    // flux); CESM provides vsf (virtual salt flux, converted to wfo at runtime).
    // wfo is the primary; vsf is its alternate (requirement "alternate"), so a
    // model with only vsf (e.g. CESM2) still resolves. At least one is required
    // for the WMT diagnostic; when both exist, wfo is used.
    "wfo": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "nlat", "nlon"],
      "standard_name" : "water_flux_into_sea_water",
      "units": "kg m-2 s-1",
      "alternates": ["vsf"]
    },
    "vsf": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "nlat", "nlon"],
      "standard_name" : "virtual_salt_flux_into_sea_water",
      "units": "kg m-2 s-1",
      "requirement": "alternate"
    },
    "hfds": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "nlat", "nlon"],
      "standard_name" : "surface_downward_heat_flux_in_sea_water",
      "units": "W m-2"
    },
    "so": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "nlat", "nlon"],
      "standard_name" : "sea_water_salinity",
      "units": "psu"
    },
    "thetao": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "nlat", "nlon"],
      "standard_name" : "sea_water_potential_temperature",
      "units": "degC"
    },
    "volcello": {
      "realm": "ocean",
      "dimensions": ["lev", "nlat", "nlon"],
      "standard_name" : "ocean_volume",
      "units": "m3"
    },
    // Velocities (uo/vo) drive the AMOC diagnostic (Part 2). Optional so models
    // without them still run Parts 1 & 3; the driver skips AMOC when absent.
    "uo": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "nlat", "nlon"],
      "standard_name" : "sea_water_x_velocity",
      "units": "m s-1",
      "requirement": "optional"
    },
    "vo": {
      "frequency" : "month",
      "realm": "ocean",
      "dimensions": ["time", "lev", "nlat", "nlon"],
      "standard_name" : "sea_water_y_velocity",
      "units": "m s-1",
      "requirement": "optional"
    },
    // Mass transport (umo/vmo): the AMOC code prefers these over uo/vo when a
    // model provides them, but CESM2 does not output them. They are intentionally
    // NOT declared here: the framework's catalog query neither skips an unmatched
    // "optional" var nor honors a per-primary "alternates" list (it pools all
    // "alternate"-requirement vars), so leaving umo/vmo in the varlist breaks the
    // wfo->vsf fallback and the velocity-only path. To run the mass-transport AMOC
    // path on a model that outputs umo/vmo, add them back as primaries here and
    // ensure that model's catalog contains them; the driver auto-selects umo/vmo
    // over uo/vo when UMO_FILE/VMO_FILE are present.
    "areacello": {
      "realm": "ocean",
      "dimensions": ["nlat", "nlon"],
      "standard_name" : "cell_area",
      "units": "m2"
    }
  }
}

